# Copy this file to .env and fill in all values before running in production.
# NEVER commit .env to version control.

# ---- Flask Core ----
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0

# ---- Database ----
# Use PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/goodgurl
# SQLite fallback for local dev only:
DATABASE_URL=sqlite:///goodgurl.db

# ---- Email (SMTP) ----
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=noreply@goodgurl.gg

# ---- Rate Limiter (Redis recommended for production) ----
# LIMITER_STORAGE_URI=redis://localhost:6379/0
# Leave unset to use in-memory (dev only):
LIMITER_STORAGE_URI=memory://

# ---- Sentry (error monitoring) ----
# Get your DSN from https://sentry.io
SENTRY_DSN=

# ---- File Storage (S3 / Cloudflare R2 / Backblaze B2) ----
# Leave unset to use local disk (dev only):
# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=auto
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # R2 / MinIO
# S3_PUBLIC_URL=https://cdn.yourdomain.com                     # Custom CDN domain

# ---- GG TV / Bot Streams ----
MEDIAMTX_RTMP=rtmp://localhost:1935/live
MEDIAMTX_HLS=http://localhost:8888

# ---- Stripe (Coin Purchases) ----
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook secret — from https://dashboard.stripe.com/webhooks (for /checkout/stripe_webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- X (Twitter) Import — Admin Panel ----
# Required to use the X Import tab. These are your X session cookies.
# How to get them:
#   1. Log in to https://x.com in your browser
#   2. Open DevTools → Application → Cookies → https://x.com
#   3. Copy the value of  auth_token  and  ct0
X_AUTH_TOKEN=your-x-auth-token-cookie
X_CT0=your-x-ct0-cookie
